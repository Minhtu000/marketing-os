{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketing-os/envelope.v1.json",
  "title": "Marketing OS Result Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "envelope_id",
    "idempotency_key",
    "action_id",
    "action_type",
    "project",
    "producer",
    "collected_at",
    "data_period",
    "status",
    "source_status",
    "read_only",
    "payload",
    "limitations",
    "checksum"
  ],
  "properties": {
    "envelope_version": {
      "const": "1.0"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "action_type": {
      "type": "string",
      "enum": ["seo.read.gsc", "seo.read.ga4", "seo.read.upgradeseo", "seo.read.backlinks", "seo.read.geolint", "seo.read.trends"]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "run_id"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "blocked",
        "error"
      ]
    },
    "source_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "read_only": {
      "const": true
    },
    "payload": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset",
          "impact",
          "status"
        ],
        "properties": {
          "dataset": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "status": {
            "const": "KNOWN"
          }
        }
      }
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
